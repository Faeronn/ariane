# Copy to .env and fill in. The server checks these at start-up and refuses to start on a
# configuration that cannot work (missing value, mail transport unusable in production...).

# development | production. production turns off pretty logs and forbids MAIL_TRANSPORT=json.
NODE_ENV=development
PORT=3000
# Number of reverse proxies in front of the API (nginx, load balancer...), so rate limits see the
# client IP. Empty or 0 when clients connect directly.
TRUST_PROXY=
# trace | debug | info | warn | error | fatal (default: info in production, debug otherwise)
LOG_LEVEL=

# MariaDB. The app user only needs SELECT, INSERT, UPDATE, DELETE;
# `npm run migrate` needs a user allowed to change the schema.
DB_HOST=localhost
DB_PORT=3306
DB_USER=ariane
DB_PASSWORD=
DB_NAME=ariane

# Long random strings, different from each other.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# SMTP account sending the verification codes.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
# true: implicit TLS (port 465). false or empty: STARTTLS is required, plaintext SMTP is refused.
MAIL_SECURE=
# Sender address of the mails (default: MAIL_USER)
MAIL_FROM=
# json: mails are rendered to the log instead of being sent (tests, local dev; refused in production)
MAIL_TRANSPORT=

# Browser origins allowed to call the API (the dashboard), comma-separated, e.g.
# https://dashboard.example.com,http://localhost:5173. Empty: no cross-origin browser call.
CORS_ORIGINS=

# NVD, source of CPEs and CVEs. Without a key: 5 requests per 30 s, with a key: 50 per 30 s.
# Free key: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# false turns the background NVD jobs off (tests, offline development)
NVD_ENABLED=true
