# Copy to .env.test. DB_NAME must end with _test: the test helpers refuse any other database.
NODE_ENV=test
# error-level lines stay visible: tests that expect a 500 mute them with captureLogs()
LOG_LEVEL=error

DB_HOST=localhost
DB_PORT=3306
DB_USER=ariane_test
DB_PASSWORD=ariane_test
DB_NAME=ariane_test

JWT_ACCESS_SECRET=test_access_secret
JWT_REFRESH_SECRET=test_refresh_secret

MAIL_TRANSPORT=json

# Background NVD jobs stay off in tests: NVD is replaced by a local stub
NVD_ENABLED=false
