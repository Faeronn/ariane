# Copy to .env.test. DB_NAME must end with _test: the test helpers refuse any other database.
NODE_ENV=test
LOG_LEVEL=silent

DB_HOST=localhost
DB_PORT=3306
DB_USER=ariane_test
DB_PASSWORD=ariane_test
DB_NAME=ariane_test

JWT_ACCESS_SECRET=test_access_secret
JWT_REFRESH_SECRET=test_refresh_secret

MAIL_TRANSPORT=json
